# ==============================================================================
# KUSHIDA — LUXURY DISCORD MUSIC BOT ENVIRONMENT VARIABLES
# ==============================================================================

# --- Discord Bot Settings ---
# Get token from: https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here
BOT_STATUS=vibe streams | /play

# --- Lavalink Audio Server (Local or Remote) ---
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_IDENTIFIER=Kushida-Node-01

# --- FastAPI Backend & Web Dashboard ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_PORT=8501
DASHBOARD_URL=http://127.0.0.1:8501

# --- SQLite Database ---
DATABASE_PATH=kushida.db

# --- Google Gemini AI (Lyric Matching & Contextual Search) ---
# Get free API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Spotify API (Save to Liked Songs OAuth) ---
# Get keys from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
